*~
*.zwc
.DS_Store
node_modules/
bower_components/
.github-token
wkhtmltopdf
# headroom が作業ディレクトリ直下に吐く memory DB 群。追跡対象にしない
.headroom/

.config/*
!.config/alacritty/
!.config/dein/
!.config/efm-langserver/
!.config/nvim/
!.config/starship.toml
!.config/terminator/
!.config/tmux/
!.config/zsh/
!.config/ghostty/
!.config/mise/
# herdr は設定と同じディレクトリにログ・ソケット・セッション状態・プラグイン実体を吐くため、
# ディレクトリごとではなく config.toml だけを追跡する。
!.config/herdr/
.config/herdr/*
!.config/herdr/config.toml
.config/**/*.zwc
**/.claude/settings.local.json

# 実機のゲートウェイ MAC を持つ設定。public リポジトリに載せない (*.example のみ追跡する)
macos/clamshell-guard/clamshell-guard.conf
